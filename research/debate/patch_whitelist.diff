 if __name__ == "__main__":
     unittest.main()
+
+
+class FeatureLeakageTests(unittest.TestCase):
+    """Diagnostic feature set must be a whitelist: unknown or outcome-like names never pass."""
+    def _item(self, raw):
+        data = {"features": {"c": raw}, "config": {}}
+        return data, {"checkpoint_id": "c", "metadata": {"nominal_age": 100, "environment_steps": 100}}
+
+    def test_unknown_outcome_like_names_are_rejected(self):
+        from experiments.rl_analysis import _allowed_features
+        raw = {"gradient_norm": 1.0, "return_after_budget": 5.0, "next_gain": 2.0, "final_score": 3.0, "lbl": 1.0}
+        data, item = self._item(raw)
+        got = _allowed_features(data, item)
+        for bad in ("return_after_budget", "next_gain", "final_score", "lbl"):
+            self.assertNotIn(bad, got)
+        self.assertIn("gradient_norm", got)
+
+    def test_clock_and_replay_features_only_in_age_baseline(self):
+        from experiments.rl_analysis import _allowed_features
+        raw = {"gradient_norm": 1.0, "environment_steps": 5, "gradient_updates": 5, "replay_size": 5,
+               "optimizer_age_min": 5, "optimizer_age_max": 5, "target_age_updates": 5}
+        data, item = self._item(raw)
+        got = _allowed_features(data, item)
+        for clock in ("environment_steps", "gradient_updates", "replay_size", "optimizer_age_min", "optimizer_age_max", "target_age_updates"):
+            self.assertNotIn(clock, got)
+        self.assertIn("replay_size", _allowed_features(data, item, age_only=True))
